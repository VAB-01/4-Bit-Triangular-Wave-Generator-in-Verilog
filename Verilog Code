module triangular(
    input wire clk,
    input wire reset,
    output reg [3:0] out
);
    reg direction;
    always @(posedge clk or posedge reset) begin
        if(reset) begin
            direction = 1'b0;
            out = -1;
        end else if(direction == 1'b0) begin
            out <= out + 1'b1;
        end if(out==4'b1110) begin
            direction = 1'b1;
        end if(direction == 1'b1) begin
            out <= out-1'b1;
        end if(out==0) begin
            direction = 1'b0;
        end if(direction == 1'b0) begin
            out<= out+1'b1;
        end
    end
endmodule
